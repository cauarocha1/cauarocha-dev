  ? '/_caua-ai'
  : import.meta.env.PUBLIC_CAUA_AI_API_URL || 'https://api.cauarocha.dev';
---

<div
  data-caua-ai-widget
  data-api-url={apiUrl}
  data-initially-open="false"
></div>
<script is:inline type="module" src="/widgets/caua-ai/caua-ai-widget.js"></script>
